{
  "hosting": {
    "site": "legend-heroes2",
    "public": "dist-internal",
    "rewrites": [
      { "source": "/api/raid-game", "run": { "serviceId": "legend-heroes-internal-raid", "region": "asia-northeast1" } }
    ],
    "ignore": ["**/.*", "**/node_modules/**", "**/*.md", "**/*prompts*.json"],
    "headers": [
      {"source": "index.html", "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}]},
      {"source": "sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}]},
      {"source": "assets/**", "headers": [{"key": "Cache-Control", "value": "public,max-age=3600"}]}
    ]
  }
}
