{
  "hosting": {
    "site": "ailandgames",
    "public": "dist-product",
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "legend-heroes-api",
          "region": "asia-northeast1"
        }
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/AGENTS.md",
      "**/*prompts*.json",
      "**/GACHA_ADDITIONS_ART.md",
      "*.py",
      "*.md"
    ],
    "headers": [
      {
        "source": "index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|svg|m4a|mp3)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.backend-only.rules"
  }
}
